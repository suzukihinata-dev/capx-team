# ローカルの開発用 Linux PC に固有の版。公式との差分確認の対象外。
# NVIDIA ドライバは導入済みのものを確認するだけで、入れ替えない。

# 動作確認済みのドライバ（これ以上であること）
NVIDIA_DRIVER_MIN=595.58

# Apptainer（公式リリースの .deb。Ubuntu 26.04 では trixie+ 版を使う）
APPTAINER_VERSION=1.5.5
APPTAINER_DEB=apptainer_1.5.5-trixie+_amd64.deb
APPTAINER_DEB_URL=https://github.com/apptainer/apptainer/releases/download/v1.5.5/apptainer_1.5.5-trixie+_amd64.deb
APPTAINER_DEB_SHA256=82a6e5ead21d3e19de522a9e0bbeb59958323e316dc9d019a128b0cc8e99d863

# uv（ホスト用。ユーザーの ~/.local/bin に入れる）
UV_VERSION=0.13.7
UV_TARBALL_URL=https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-gnu.tar.gz
UV_TARBALL_SHA256=c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83
