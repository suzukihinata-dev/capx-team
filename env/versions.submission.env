# 提出イメージ・GMO と一致させる版（ビルドの入力専用）。
# 公式配布後は、差分確認（env/tools/diff_versions.py）の結果に合わせてこのファイルを更新する。
# ビルドの結果（base.sif の SHA-256 など）はここに書かず、env/images.lock に記録する。

# 手順の版番号。env/jobs/ を変えたら上げ、自動化用の固定スクリプトも同じ日に更新する。
JOB_PROTOCOL_VERSION=1

# 基盤イメージのベース（仮版）。公式がベースを指定したら置き換える。
# CUDA 13.2.1（必要ドライバ 595.58 以上）、vLLM 0.21.0。digest は amd64 のマニフェスト。
BASE_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
BASE_IMAGE_DIGEST=sha256:a7df7ccf5e772800d4e8e1be1850846d5e65a06cce04d73e8e83f4dd4f7c033b

# uv（コンテナ内で仮想環境を作るのに使う）
UV_VERSION=0.13.7

# シミュレータ（仮版）。依存の正確な版は env/requirements/*.txt（ハッシュ付き）で固定する。
ROBOSUITE_PYTHON=3.12
LIBERO_PYTHON=3.10
LIBERO_REPO=https://github.com/Lifelong-Robot-Learning/LIBERO.git
LIBERO_COMMIT=8f1084e3132a39270c3a13ebe37270a43ece2a01

# 公式リポジトリ（公式配布後に記入する。取り込まず、URL とコミットで参照する）
OFFICIAL_REPO_URL=
OFFICIAL_COMMIT=
# 評価コード（gateway / EnvClient）の SHA-256 一覧（公式配布後に env/tools/eval_code_hash.py で作る）
EVAL_CODE_SHA256_LIST=env/eval_code.sha256
